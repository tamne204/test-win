# 2TOOLNE SECURE AUTHENTICATED SOFTWARE DOWNLOAD GATE
# All direct static downloads of executables, archives, and metadata are strictly forbidden.
# All downloads must be authenticated and authorized via /api/v1/downloads/request and streamed via short-lived signed tokens.

Options -Indexes

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

<FilesMatch "\.(?i:exe|zip|dmg|pkg|7z|rar|tar|gz|json|sha256|bat|sh|ps1)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
